
&НаКлиенте
Процедура ПросмотрУпаковок(Команда)	

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОтборНоменклатура", Объект.Ссылка);
	
	ОткрытьФорму(
		"Справочник.УпаковкиНоменклатуры.ФормаСписка", 
		ПараметрыОтбора, 
		ЭтаФорма, 
		Строка(Объект.Ссылка.УникальныйИдентификатор())
	);
КонецПроцедуры

